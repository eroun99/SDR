# Vivado: generated working directories (keep authored sources outside these)
.Xil/
*.cache/
*.runs/
*.sim/
*.hw/
*.ip_user_files/

# Vivado: logs and transient reports
vivado*.jou
vivado*.log
vivado*.str
webtalk*.jou
webtalk*.log
webtalk*.xml
webtalk*.html
usage_statistics_webtalk.*

# Python: caches and local virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local secrets (example configuration files may be committed)
.env
.env.*
!.env.example

# Operating-system metadata
Thumbs.db
Desktop.ini
.DS_Store

# Do not blanket-ignore .xpr, .bd, .xci, .srcs or .gen.
# Inspect source dependencies before excluding additional project files.
